# ==============================================================================
# GITIGNORE - BUENAS PRÁCTICAS DE SEGURIDAD Y DESARROLLO
# ==============================================================================

# Dependencias (se instalan con npm install)
node_modules/

# Archivos de entorno y credenciales (NUNCA subir a GitHub)
.env
.env.local
*.env

# Historial de eventos y estados en tiempo real
events-history.json

# Archivos de respaldo de base de datos
backups/*.sql
backups/*.sql.gz
!backups/.gitkeep

# Logs y depuración
*.log
npm-debug.log*

# Archivos del sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
