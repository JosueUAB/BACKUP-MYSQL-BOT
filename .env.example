# ==============================================================================
# CONFIGURACIÓN DEL MONITOR UPS Y ALTA DISPONIBILIDAD (FAILOVER / TELEGRAM)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR WEB Y MONITOR UPS
# ------------------------------------------------------------------------------
PORT=3000
POLL_INTERVAL_MS=2500
BATTERY_LOW=20.8
BATTERY_HIGH=27.4
NOMINAL_WATTS=375

# ------------------------------------------------------------------------------
# 2. BASES DE DATOS (HOMELAB Y REMOTO POR VPN)
# Motores soportados: postgres | mysql | mariadb
# ------------------------------------------------------------------------------
DB_TYPE=postgres
DB_NAME=mi_base_de_datos
DB_USER=postgres
DB_PASSWORD=tu_password_seguro

# Nodo A: HomeLab (Servidor Principal en tu red local)
PRIMARY_HOST=192.168.1.100
PRIMARY_PORT=5432

# Nodo B: Servidor Remoto (Servidor Secundario a través de la VPN)
STANDBY_HOST=10.8.0.2
STANDBY_PORT=5432

# ------------------------------------------------------------------------------
# 3. ORQUESTADOR DE ALTA DISPONIBILIDAD Y RESPALDOS
# ------------------------------------------------------------------------------
# Intervalo de respaldos programados en minutos (ej: 60 para cada hora)
BACKUP_INTERVAL_MINUTES=60

# Batería crítica para ejecutar conmutación automática (en %)
# Si hay corte de luz y la batería baja de este % (o inmediatamente),
# se congela HomeLab y se activa el Servidor Remoto.
FAILOVER_BATTERY_THRESHOLD=30
AUTO_FAILOVER_ON_OUTAGE=true

# ------------------------------------------------------------------------------
# 4. BOT DE TELEGRAM (ALERTAS Y CONTROL EN EL MÓVIL)
# Obtén tu token con @BotFather y tu chat id con @userinfobot en Telegram
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
